<?xml version="1.0" encoding="utf-8"?>
<!-- Outer WebSocket transport may use cleartext; its payload is pinned TLS.
     Direct connections are checked by AddressPolicy before credentials are sent. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
